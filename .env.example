# Copy this file to .env and fill in your values.

# --- Notifications ---
# At least one must be set.

# Discord: paste your webhook URL from Server Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Telegram: create a bot via @BotFather, get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Polling ---
# How often to check when stock is unknown (seconds). Default: 30
POLL_INTERVAL_SECONDS=30

# Faster interval used when a product was recently OOS and may restock soon (seconds). Default: 10
POLL_INTERVAL_FAST_SECONDS=10

# Maximum jitter added to each poll (seconds). Randomises timing. Default: 5
POLL_JITTER_MAX_SECONDS=5

# --- Browser ---
# Set to 1 to auto-open the product page in your browser on restock detection.
AUTO_OPEN_BROWSER=1

# --- Proxy (optional) ---
# HTTP proxy URL if you want to route requests through one.
# Example: http://user:pass@host:port
HTTP_PROXY=
